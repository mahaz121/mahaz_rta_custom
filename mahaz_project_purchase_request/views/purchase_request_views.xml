<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="mahaz_purchase_request_form" model="ir.ui.view">
    <field name="name">mahaz_purchase_request_form</field>
    <field name="model">purchase.request</field>
    <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
    <field name="priority">16</field>
    <field name="arch" type="xml">
      <xpath expr="/form/sheet" position="inside">
        <group name="mahaz_task_integration" string="Task Integration">
          <field name="mahaz_task_id" options="{'no_create': True}"/>
          <field name="mahaz_payment_source"/>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
