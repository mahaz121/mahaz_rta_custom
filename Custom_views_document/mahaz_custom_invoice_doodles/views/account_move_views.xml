<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mahaz_view_move_form_doodle" model="ir.ui.view">
        <field name="name">account.move.form.mahaz.doodle</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook" position="inside">
                <page
                    name="mahaz_invoice_doodles"
                    string="Invoice Notes &amp; Doodles"
                    invisible="move_type not in ('out_invoice', 'out_refund')"
                    groups="account.group_account_invoice,account.group_account_readonly"
                >
                    <div class="border rounded p-4 bg-light">
                        <h3>Invoice Doodle</h3>
                        <p class="text-muted">
                            Draw or upload an image using the signature box.
                            Save the invoice before printing. Use the image
                            controls below to replace or remove your doodle.
                        </p>
                        <div groups="account.group_account_invoice">
                            <field
                                name="doodle_image"
                                widget="signature"
                                nolabel="1"
                                options="{'size': [600, 180]}"
                                class="mw-100"
                            />
                        </div>
                        <group string="Saved Drawing">
                            <field
                                name="doodle_image"
                                widget="image"
                                string="Drawing"
                                options="{'size': [360, 120]}"
                                groups="account.group_account_invoice"
                            />
                            <field
                                name="doodle_image"
                                widget="image"
                                string="Drawing"
                                readonly="1"
                                options="{'size': [360, 120]}"
                                groups="!account.group_account_invoice"
                            />
                        </group>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
