<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="mahaz_task_form" model="ir.ui.view">
    <field name="name">mahaz_task_form</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="project.view_task_form2"/>
    <field name="priority">16</field>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
      <field name="mahaz_can_read_expense" invisible="1"/>
      <button name="mahaz_action_view_expenses" type="object" class="oe_stat_button" icon="fa-money"
              invisible="not id or not mahaz_can_read_expense">
        <field name="mahaz_expense_count" widget="statinfo" string="Expenses"/>
      </button>
      <field name="mahaz_can_read_document" invisible="1"/>
      <button name="mahaz_action_view_documents" type="object" class="oe_stat_button" icon="fa-files-o"
              invisible="not id or not mahaz_can_read_document">
        <field name="mahaz_document_count" widget="statinfo" string="Documents"/>
      </button>
      <field name="mahaz_can_read_purchase" invisible="1"/>
      <button name="mahaz_action_view_purchases" type="object" class="oe_stat_button" icon="fa-shopping-cart"
              invisible="not id or not mahaz_can_read_purchase">
        <field name="mahaz_purchase_count" widget="statinfo" string="Purchases"/>
      </button>
      <field name="mahaz_can_read_invoice" invisible="1"/>
      <button name="mahaz_action_view_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o"
              invisible="not id or not mahaz_can_read_invoice">
        <field name="mahaz_invoice_count" widget="statinfo" string="Invoices"/>
      </button>
      </xpath>
      <xpath expr="//header" position="inside">
        <field name="mahaz_can_create_expense" invisible="1" groups="base.group_user"/>
        <button name="mahaz_action_create_expense" type="object" string="Create Expense"
                invisible="not id or not mahaz_can_create_expense" groups="base.group_user"/>
        <field name="mahaz_can_create_purchase" invisible="1" groups="base.group_user"/>
        <button name="mahaz_action_create_purchase" type="object" string="Create Purchase"
                invisible="not id or not mahaz_can_create_purchase" groups="base.group_user"/>
        <field name="mahaz_can_create_invoice" invisible="1" groups="base.group_user"/>
        <button name="mahaz_action_create_invoice" type="object" string="Create Invoice"
                invisible="not id or not mahaz_can_create_invoice" groups="base.group_user"/>
      </xpath>
    </field>
  </record>
</odoo>
